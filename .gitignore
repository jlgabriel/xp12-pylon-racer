node_modules/
dist/
out/
build/
coverage/
test-results/
playwright-report/
*.log
*.tsbuildinfo

# Scratch. Anything you need to keep out of the history goes here.
scratch/

# Local machine paths, never committed
.env
.env.local
# Agent notes name this computer's drives and installs; local, as in Pylon Racer
.claude/CLAUDE.md

# Probe output: packs are rebuilt by `npm run probe:pack`, runs are one flight's raw log.
# A run worth keeping is summarised into its probe's FLIGHT.md, not committed raw.
probes/H1/XPR_*/
probes/H0/runs/
# The in-sim display plugin: the X-Plane SDK is downloaded, not committed; the build and the plugin
# folder are rebuilt by `npm run plugin`.
plugin/sdk/
plugin/build/
plugin/out/
probes/H3/sdk/
probes/H3/build/
probes/H3/XPR_*/
